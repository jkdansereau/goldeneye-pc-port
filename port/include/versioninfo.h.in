#ifndef PORT_VERSIONINFO_H
#define PORT_VERSIONINFO_H

/* Generated by CMake from versioninfo.h.in — do not edit.
 * Force-included into every TU, so it must not change from commit to commit
 * (that would defeat ccache across branches and worktrees): the git hash lives
 * in versionhash.h, included only where it is printed. */

#define GE007_VERSION "@GE007_VERSION@"
#define GE007_VERSION_CODENAME "@VERSION_CODENAME@"
#define GE007_ORIGIN_URL "@ORIGIN_URL@"
#define GE007_TARGET_PLATFORM "@TARGET_PLATFORM@"
#define GE007_ROMID "@ROMID@"
#define GE007_IS_PAL @VERSION_IS_PAL@

#endif /* PORT_VERSIONINFO_H */
