#ifndef PORT_HOSTSCHED_H
#define PORT_HOSTSCHED_H
/* Generated by CMake from hostsched.h.in — do not edit.
 * Includes the HOST <sched.h> by absolute path so that port/shim/sched.h can
 * give C++ TUs (fast3d, libstdc++'s <thread>/gthr headers) the real
 * <sched.h> — cpu_set_t, sched_yield — instead of the decomp's src/sched.h,
 * which sits on the include path and would otherwise shadow it. */
#include "@PORT_HOST_SCHED_H@"
#endif
