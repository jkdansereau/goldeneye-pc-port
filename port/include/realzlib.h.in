#ifndef PORT_REALZLIB_H
#define PORT_REALZLIB_H
/* Generated by CMake from realzlib.h.in — do not edit.
 * Includes the HOST <zlib.h> by absolute path so port/src/rzdecomp.c can use
 * the real zlib (inflateInit2/inflate) without picking up the game's own
 * src/game/zlib.h, which sits on the -I search path and shadows a plain
 * `#include <zlib.h>` in a port TU. Same absolute-path trick as hoststring.h.
 * See docs/internals.md §F (D32). */
#include "@PORT_REAL_ZLIB_H@"
#endif
